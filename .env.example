# Copy this file to .env.local for local development or configure the same
# variables in your production platform. Do not commit real secrets.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/football_ai?schema=public"
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/football_ai?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="change-me-minimum-32-characters-long"

# Optional OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# Football data
# Supported providers: sportmonks | api-football | scraping | demo
# Runtime default when unset: api-football. Use DATA_PROVIDER=demo only for local demos/tests.
DATA_PROVIDER="api-football"
SPORTMONKS_API_TOKEN=""
API_FOOTBALL_KEY=""
FOOTBALL_DATA_API_TOKEN=""
ALLOW_DEMO_FALLBACK="false"
# Keep the fixtures board fast by default. Exact fixture analysis fetches odds on demand.
# Odds prefetch for fixture lists (enabled by default). Set to "false" to disable.
# API_FOOTBALL_PREFETCH_FIXTURE_ODDS="false"
# Max pages from /odds?date= when loading daily odds (default 30, or 8 with league filter)
API_FOOTBALL_ODDS_MAX_PAGES="30"
# Per-fixture fallback when bulk odds miss a match (default 80 fixtures, 8 concurrent)
# API_FOOTBALL_ODDS_BATCH_LIMIT="80"
# API_FOOTBALL_ODDS_BATCH_CONCURRENCY="8"

# Email
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="Football AI <noreply@example.com>"

# Observability
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Cache and rate limiting
REDIS_URL="redis://localhost:6379"

# App config
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/Bogota"
FEATURE_ODD_MOVEMENT_ALERTS="false"

# Cron: required by /api/cron/resolve-predictions
CRON_SECRET="change-me-cron-secret-minimum-32-characters"
